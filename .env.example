# ---------------------------------------------------------------------------
# Database (PostgreSQL 14+)
# ---------------------------------------------------------------------------
# Running without Docker: point this at your Postgres server.
DATABASE_URL=postgres://postpidia:change-me@localhost:5432/postpidia
# Used by docker-compose.yml to create the database user (DATABASE_URL is built from it there).
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public URL of the site (used in password-reset emails).
APP_URL=https://postpidia.com
PORT=3000
# Where uploaded footage and finished edits are stored. Back this folder up!
UPLOAD_DIR=./uploads
# Max size per uploaded file in bytes (default 10 GB).
MAX_UPLOAD_BYTES=10737418240

# ---------------------------------------------------------------------------
# Email (password resets). Without SMTP_URL, emails are printed to the server log.
# ---------------------------------------------------------------------------
SMTP_URL=
MAIL_FROM=Postpidia <no-reply@postpidia.com>

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=your_paystack_secret_key
