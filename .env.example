# Copy to .env and fill in. Never commit the real .env file.

# Paystack keys: Dashboard > Settings > API Keys & Webhooks
# The secret key stays on the server.
PAYSTACK_SECRET_KEY=sk_live_or_sk_test_xxx
# The public key is built into the website pages, so rebuild (npm run build) after changing it.
VITE_PAYSTACK_PUBLIC_KEY=pk_live_or_pk_test_xxx

# Where paid subscriptions are stored (SQLite file). Relative paths are from the project folder.
DATABASE_PATH=data/postpidia.db
